# Required API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
FISH_API_KEY=your-fish-audio-api-key-here

# Optional: Fish Audio voice model (defaults to JARVIS MCU voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Optional: D-ID API key — enables the lip-synced Marion avatar for the FR/TR
# personas (Phase 2). Without it, those personas show the static face that
# reacts to her voice (Phase 1). Get a key at https://studio.d-id.com (API).
# Accepts the console token as-is, or an "email:password" pair (auto-encoded).
# DID_API_KEY=your-d-id-api-key-here

# Optional: Your name (JARVIS will address you by name)
# USER_NAME=Tony

# Optional: Specific Apple Calendar accounts to read (comma-separated emails)
# If not set, JARVIS reads ALL calendars from Apple Calendar
# CALENDAR_ACCOUNTS=you@gmail.com,work@company.com

# Optional: Whether to skip Claude CLI permission prompts on subprocess calls.
# Defaults to "true" because JARVIS is voice-driven and cannot respond to
# interactive permission prompts (they would silently hang the subprocess).
# Set to "false" to require explicit permission prompts — only useful when
# running JARVIS interactively in a Terminal you can see and respond to.
# JARVIS_SKIP_PERMISSIONS=true

# Optional: Override the auto-detected weather location.
# By default, JARVIS uses your public-IP location (via ipwho.is) and reports
# Celsius. Set these to pin a specific location:
# WEATHER_LOCATION_LABEL=Austin, TX
# WEATHER_LATITUDE=30.2672
# WEATHER_LONGITUDE=-97.7431
# WEATHER_UNIT=celsius  # or "fahrenheit"

# Optional: Heart-rate monitoring (near-real-time spoken alerts).
# An iOS app (e.g. Health Auto Export) reads Apple Watch data from HealthKit and
# POSTs it to https://localhost:8340/api/health/ingest?token=YOUR_TOKEN on a
# schedule (~1/min). JARVIS stores it and, on a sustained threshold breach, speaks
# a warning through any open browser. NOT a medical device — keep the Apple Watch's
# own High/Low/Irregular-Rhythm notifications enabled as the validated safety net.
# HEALTH_WEBHOOK_TOKEN=a-long-random-secret   # shared with the iOS app (recommended)
# HEALTH_HR_MAX=120            # alert above this many bpm
# HEALTH_HR_MIN=40             # alert below this many bpm
# HEALTH_ALERT_COOLDOWN=600    # seconds between repeat alerts of the same kind
# HEALTH_ALERT_LANG=en         # voice language for alerts: en | fr | tr

# Autonomous bug-fixer: when true, Marion drafts fixes for recurring bugs on a
# timer (isolated branch, claude headless). Merges still require your approval.
BUGFIX_ENABLED=false
